---
import { getSEOConfig, generateStructuredData } from '../../lib/seo/seoConfig';
import {
  ALEXA_SITE_VERIFICATION,
  BING_SITE_VERIFICATION,
  BRAND_AUTHOR,
  BRAND_NAME,
  GOOGLE_SITE_VERIFICATION,
  SITE_URL,
  YANDEX_SITE_VERIFICATION
} from '../../lib/site/config';

export interface DynamicSEOProps {
  page: string;
  title?: string;
  description?: string;
  keywords?: string[];
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  noIndex?: boolean;
  customStructuredData?: Record<string, any> | Record<string, any>[];
}

const {
  page = 'home',
  title,
  description,
  keywords,
  canonical,
  ogImage,
  ogImageAlt,
  noIndex = false,
  customStructuredData
} = Astro.props as DynamicSEOProps;

const baseConfig = getSEOConfig(page);
const seoTitle = title || baseConfig.title;
const seoDescription = description || baseConfig.description;
const seoKeywords = keywords ? [...baseConfig.keywords, ...keywords].join(', ') : baseConfig.keywords.join(', ');
const seoCanonical = canonical || baseConfig.canonical || Astro.url.href;
const seoOgImage = ogImage || baseConfig.ogImage;
const seoOgImageAlt = ogImageAlt || baseConfig.ogImageAlt;
const structuredData = customStructuredData || generateStructuredData(page);
const currentUrl = Astro.url.href;
const breadcrumbLabel = seoTitle.split('|')[0].trim();
---

<title>{seoTitle}</title>
<meta name="title" content={seoTitle} />
<meta name="description" content={seoDescription} />
<meta name="keywords" content={seoKeywords} />
<meta name="author" content={BRAND_AUTHOR} />
<meta name="robots" content={noIndex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
<meta name="googlebot" content={noIndex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
<meta name="language" content="English" />

<link rel="canonical" href={seoCanonical} />

<meta property="og:type" content="website" />
<meta property="og:url" content={currentUrl} />
<meta property="og:site_name" content={BRAND_NAME} />
<meta property="og:title" content={seoTitle} />
<meta property="og:description" content={seoDescription} />
<meta property="og:locale" content="en_US" />
{seoOgImage && <meta property="og:image" content={seoOgImage} />}
{seoOgImage && <meta property="og:image:secure_url" content={seoOgImage} />}
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{seoOgImageAlt && <meta property="og:image:alt" content={seoOgImageAlt} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={currentUrl} />
<meta name="twitter:title" content={seoTitle} />
<meta name="twitter:description" content={seoDescription} />
{seoOgImage && <meta name="twitter:image" content={seoOgImage} />}
{seoOgImageAlt && <meta name="twitter:image:alt" content={seoOgImageAlt} />}
<meta name="twitter:creator" content="@BiergeGustavo" />

<meta name="copyright" content={BRAND_NAME} />
<meta name="distribution" content="global" />
<meta name="audience" content="business" />
<meta name="page-topic" content="Technical Due Diligence" />
<meta name="subject" content="Energy Infrastructure Investment" />
<meta name="format-detection" content="telephone=no" />
<meta name="theme-color" content="#0f172a" />

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />

{page !== 'home' && (
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: `${SITE_URL}/`
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: breadcrumbLabel,
          item: seoCanonical
        }
      ]
    })}
    is:inline
  />
)}

{GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}
{BING_SITE_VERIFICATION && <meta name="msvalidate.01" content={BING_SITE_VERIFICATION} />}
{YANDEX_SITE_VERIFICATION && <meta name="yandex-verification" content={YANDEX_SITE_VERIFICATION} />}
{ALEXA_SITE_VERIFICATION && <meta name="alexaVerifyID" content={ALEXA_SITE_VERIFICATION} />}
