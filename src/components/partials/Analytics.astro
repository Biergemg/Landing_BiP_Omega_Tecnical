---
import { GOOGLE_ANALYTICS_ID } from '../../lib/site/config';
---

<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GOOGLE_ANALYTICS_ID}`} onerror="console.warn('GA script failed to load')"></script>
<script>
  try {
    import('../../lib/analytics/gtag').then((module) => {
      module.initGtag();
    }).catch(() => {
      // Fail silently - analytics is optional
    });
  } catch {
    // Fail silently - analytics is optional
  }
</script>

<script>
  try {
    import('../../lib/analytics/init').then((module) => {
      module.initAnalytics();
    }).catch(() => {
      // Fail silently - analytics is optional
    });
  } catch {
    // Fail silently - analytics is optional
  }
</script>
