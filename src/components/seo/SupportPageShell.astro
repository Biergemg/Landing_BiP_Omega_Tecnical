---
interface Props {
  eyebrow?: string;
  title: string;
  intro: string;
  primaryKeyword: string;
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  eyebrow,
  title,
  intro,
  primaryKeyword,
  ctaHref = '/#contact',
  ctaLabel = 'Request Initial Scope'
} = Astro.props;
---

<section class="bg-slate-50 border-b border-slate-200 pt-32 pb-16">
  <div class="section-container max-w-4xl">
    {eyebrow && (
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-indigo-700 mb-4">{eyebrow}</p>
    )}
    <h1 class="text-4xl lg:text-5xl font-bold text-slate-900 leading-tight mb-6">{title}</h1>
    <p class="text-lg text-slate-600 leading-relaxed max-w-3xl mb-8">{intro}</p>

    <div class="flex flex-col sm:flex-row gap-4 items-start sm:items-center">
      <a href={ctaHref} class="btn-primary text-center">{ctaLabel}</a>
      <span class="text-sm text-slate-500">Primary query target: {primaryKeyword}</span>
    </div>
  </div>
</section>
