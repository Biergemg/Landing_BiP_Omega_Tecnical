---
import { type BaseSectionProps } from '../../types/components';

interface Props extends BaseSectionProps {}
const { id = "scope" } = Astro.props;
---

<section id={id} class="bg-slate-50 py-12 lg:py-16 border-t border-slate-200">
  <div class="section-container">
    <div class="max-w-4xl mx-auto">
      <h3 class="text-lg font-bold text-slate-900 uppercase tracking-widest mb-8 text-center">Formal Statement of Scope</h3>
      
      <div class="grid md:grid-cols-2 gap-8 text-sm">
        <!-- DOES NOT -->
        <div class="bg-white p-6 rounded-sm border border-slate-200">
          <h4 class="font-bold text-slate-900 mb-4 border-b border-slate-100 pb-2">BiP Omega DOES NOT:</h4>
          <ul class="space-y-3 text-slate-600">
            <li class="flex items-start gap-2">
              <span class="text-red-500 font-bold">×</span>
              <span>Act as operational advisor or execute project tasks.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-red-500 font-bold">×</span>
              <span>Interact with third parties (EPCs, Suppliers, Authorities).</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-red-500 font-bold">×</span>
              <span>Certify contracts or validate compliance.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-red-500 font-bold">×</span>
              <span>Guarantee bankability, insurability, or financial returns.</span>
            </li>
          </ul>
        </div>

        <!-- DOES -->
        <div class="bg-slate-50 p-6 rounded-sm border border-slate-200">
          <h4 class="font-bold text-slate-900 mb-4 border-b border-slate-200 pb-2">BiP Omega DOES:</h4>
          <ul class="space-y-3 text-slate-600">
            <li class="flex items-start gap-2">
              <span class="text-green-600 font-bold">✓</span>
              <span>Applies a structured analytical process to technical due diligence mandates.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-green-600 font-bold">✓</span>
              <span>Identifies material evidence gaps, execution risks, and documentary silences.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-green-600 font-bold">✓</span>
              <span>Produces traceable technical conclusions: GO / CONDITIONAL NO-GO / NO-GO.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-green-600 font-bold">✓</span>
              <span>Adapts scope, sources, and deliverable format to the mandate requirements.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-green-600 font-bold">✓</span>
              <span>Delivers findings through formal written technical documentation.</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Pricing -->
      <div class="mt-8 bg-white p-6 rounded-sm border border-slate-200 text-sm">
        <h4 class="font-bold text-slate-900 mb-3 text-base">Request Initial Scope</h4>
        <p class="text-slate-600 mb-4 leading-relaxed">
          If you are evaluating a utility-scale BESS project and need a technical assessment before or during diligence, BiP Omega can assess likely scope based on project complexity, mandate type, and documentation scope.
        </p>
        <p class="text-slate-600 mb-2">
           Mandates are quoted after initial scope consultation.
        </p>
        <p class="text-slate-600 mb-4">
          <strong>Pricing factors:</strong> project complexity, mandate type, and documentation scope.
        </p>
        <p class="font-bold text-slate-900 border-t border-slate-100 pt-3">
          No hourly billing. No scope creep. Fixed-price proposal with binary deliverable.
        </p>
      </div>
    </div>
  </div>
</section>
