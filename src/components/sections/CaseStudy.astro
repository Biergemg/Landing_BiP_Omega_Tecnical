---
import { type BaseSectionProps } from '../../types/components';

interface Props extends BaseSectionProps {}
const { id = "casestudy" } = Astro.props;
---

<section id={id} class="bg-indigo-900 overflow-hidden relative py-12 lg:py-20">
  <!-- Subtle pattern overlay -->
  <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]"></div>
  
  <div class="section-container relative z-10">
    <div class="max-w-4xl mx-auto text-center mb-10">
      <h2 class="text-3xl font-bold text-white mb-6">See the report format</h2>
      <p class="text-indigo-200 text-lg max-w-2xl mx-auto">
        Download a sanitized example of the Phase 1 technical gating report to see the structure, evidence discipline, and decision format delivered to clients.
      </p>
    </div>

    <div class="bg-white rounded-sm shadow-xl overflow-hidden max-w-5xl mx-auto flex flex-col md:flex-row">
      <div class="p-8 md:p-12 md:w-2/3">
        <h3 class="text-2xl font-bold text-slate-900 mb-2">Sanitized Phase 1 Technical Gating Report</h3>
        <p class="text-slate-600 mb-6 text-sm leading-relaxed">
          This sample report shows how BiP Omega structures evidence classification, technical gating, and documentary risk explanation using public records alone.
        </p>

        <div class="grid sm:grid-cols-2 gap-4 mb-8">
            <ul class="space-y-2 text-sm text-slate-700">
                <li class="flex items-center gap-2">
                    <span class="text-green-600 font-bold">✓</span> Evidence-Grade Parameter Register
                </li>
                <li class="flex items-center gap-2">
                    <span class="text-green-600 font-bold">✓</span> Critical Silence Register
                </li>
                <li class="flex items-center gap-2">
                    <span class="text-green-600 font-bold">✓</span> Evidence-Based Risk Register
                </li>
            </ul>
            <ul class="space-y-2 text-sm text-slate-700">
                <li class="flex items-center gap-2">
                    <span class="text-green-600 font-bold">✓</span> Binary Go/No-Go Decision Matrix
                </li>
                <li class="flex items-center gap-2">
                    <span class="text-green-600 font-bold">✓</span> Forensic explanation and decision basis
                </li>
            </ul>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 items-center">
            <a href="/REPORT_PUBLIC_CASE_STUDY.pdf" download="BiP_Omega_Imperial_Valley_BESS_Case_Study.pdf" class="btn-primary w-full sm:w-auto text-center group">
                Download Sample Report
            </a>
            <span class="text-xs text-slate-500 italic">
                No email required - immediate PDF download
            </span>
        </div>
      </div>
      
      <div class="bg-indigo-50 p-8 md:w-1/3 flex flex-col justify-center items-center border-t md:border-t-0 md:border-l border-indigo-100">
         <div class="text-center">
            <span class="block text-4xl font-bold text-indigo-900 mb-1">Public-record</span>
            <span class="block text-sm text-indigo-700 font-medium uppercase tracking-wide">technical gate</span>
            <span class="block text-xs text-indigo-400 mt-1">structured for investment screening</span>
         </div>
      </div>
    </div>
  </div>
</section>
