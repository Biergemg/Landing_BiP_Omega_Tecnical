---
import { type BaseSectionProps } from '../../types/components';

interface Props extends BaseSectionProps {}
const { id = "casestudy" } = Astro.props;
---

<section id={id} class="bg-slate-900 overflow-hidden relative py-12 lg:py-20">
  <!-- Subtle pattern overlay -->
  <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]"></div>

  <div class="section-container relative z-10">
    <div class="max-w-4xl mx-auto text-center mb-10">
      <h2 class="text-3xl font-bold text-white mb-6">See exactly what you receive</h2>
      <p class="text-slate-300 text-lg max-w-2xl mx-auto">
        Download a reference assessment — the actual deliverable format, with evidence classification, documented gaps, and a traceable GO / NO-GO verdict.
      </p>
    </div>

    <div class="bg-white rounded-sm shadow-xl overflow-hidden max-w-5xl mx-auto flex flex-col md:flex-row">
      <div class="p-8 md:p-12 md:w-2/3">
        <h3 class="text-2xl font-bold text-slate-900 mb-2">Pre-Investment Technical Assessment — Reference Case</h3>
        <p class="text-slate-600 mb-6 text-sm leading-relaxed">
          Reference assessment format: every finding classified, every material gap named with its screening implications, and a final verdict with documented rationale — the complete picture, not a narrative summary.
        </p>

        <div class="grid sm:grid-cols-2 gap-4 mb-8">
            <ul class="space-y-2 text-sm text-slate-700">
                <li class="flex items-center gap-2">
                    <span class="text-green-600 font-bold">✓</span> Confirmed / Unverified / Gap Register
                </li>
                <li class="flex items-center gap-2">
                    <span class="text-green-600 font-bold">✓</span> Material Gap Analysis with screening implications
                </li>
                <li class="flex items-center gap-2">
                    <span class="text-green-600 font-bold">✓</span> Risk Register by dimension
                </li>
            </ul>
            <ul class="space-y-2 text-sm text-slate-700">
                <li class="flex items-center gap-2">
                    <span class="text-green-600 font-bold">✓</span> Annual vs. one-time stress ranges
                </li>
                <li class="flex items-center gap-2">
                    <span class="text-green-600 font-bold">✓</span> Final verdict with GO conditions and decision rationale
                </li>
            </ul>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 items-center">
            <a href="/REPORT_PUBLIC_CASE_STUDY.pdf" download="BiP_Omega_Technical_Assessment_Sample.pdf" class="btn-primary w-full sm:w-auto text-center group">
                Download Sample Report
            </a>
            <span class="text-xs text-slate-500 italic">
                No email required — immediate PDF download
            </span>
        </div>
      </div>

      <div class="bg-slate-50 p-8 md:w-1/3 flex flex-col justify-center items-center border-t md:border-t-0 md:border-l border-slate-200">
         <div class="text-center space-y-4">
            <div>
              <span class="block text-3xl font-bold text-slate-900 mb-1">CONDITIONAL</span>
              <span class="block text-xl font-bold text-red-700">NO-GO</span>
              <span class="block text-xs text-slate-500 mt-1 uppercase tracking-wide">Sample verdict</span>
            </div>
            <div class="border-t border-slate-200 pt-4">
              <span class="block text-sm font-semibold text-slate-800">$4–10.5M / yr</span>
              <span class="block text-xs text-slate-500">illustrative annual stress range</span>
            </div>
            <div>
              <span class="block text-sm font-semibold text-slate-800">$8–15M one-time</span>
              <span class="block text-xs text-slate-500">illustrative interconnection stress</span>
            </div>
            <div>
              <span class="block text-sm font-semibold text-slate-800">3 critical + 1 high</span>
              <span class="block text-xs text-slate-500">material evidence gaps</span>
            </div>
         </div>
      </div>
    </div>
  </div>
</section>
