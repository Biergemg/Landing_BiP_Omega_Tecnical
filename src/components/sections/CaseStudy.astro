---
import { type BaseSectionProps } from '../../types/components';

interface Props extends BaseSectionProps {}
const { id = "casestudy" } = Astro.props;
---

<section id={id} class="bg-indigo-900 overflow-hidden relative py-12 lg:py-20">
  <!-- Subtle pattern overlay -->
  <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]"></div>

  <div class="section-container relative z-10">
    <div class="max-w-4xl mx-auto text-center mb-10">
      <h2 class="text-3xl font-bold text-white mb-6">See the report format</h2>
      <p class="text-indigo-200 text-lg max-w-2xl mx-auto">
        Download a reference case study showing the evidence classification, risk documentation, and traceable decision format delivered to clients.
      </p>
    </div>

    <div class="bg-white rounded-sm shadow-xl overflow-hidden max-w-5xl mx-auto flex flex-col md:flex-row">
      <div class="p-8 md:p-12 md:w-2/3">
        <h3 class="text-2xl font-bold text-slate-900 mb-2">Pre-Investment Technical Assessment — Reference Case</h3>
        <p class="text-slate-600 mb-6 text-sm leading-relaxed">
          This reference case shows how BiP Omega structures evidence classification, risk documentation, and technical gate conclusions — with every finding classified and every conclusion traceable.
        </p>

        <div class="grid sm:grid-cols-2 gap-4 mb-8">
            <ul class="space-y-2 text-sm text-slate-700">
                <li class="flex items-center gap-2">
                    <span class="text-green-600 font-bold">✓</span> Evidence Classification Register
                </li>
                <li class="flex items-center gap-2">
                    <span class="text-green-600 font-bold">✓</span> Critical Silence Analysis
                </li>
                <li class="flex items-center gap-2">
                    <span class="text-green-600 font-bold">✓</span> Evidence-Based Risk Register
                </li>
            </ul>
            <ul class="space-y-2 text-sm text-slate-700">
                <li class="flex items-center gap-2">
                    <span class="text-green-600 font-bold">✓</span> Financial Exposure Analysis
                </li>
                <li class="flex items-center gap-2">
                    <span class="text-green-600 font-bold">✓</span> Technical Gate Decision with GO conditions
                </li>
            </ul>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 items-center">
            <a href="/REPORT_PUBLIC_CASE_STUDY.pdf" download="BiP_Omega_Technical_Assessment_Sample.pdf" class="btn-primary w-full sm:w-auto text-center group">
                Download Sample Report
            </a>
            <span class="text-xs text-slate-500 italic">
                No email required — immediate PDF download
            </span>
        </div>
      </div>

      <div class="bg-indigo-50 p-8 md:w-1/3 flex flex-col justify-center items-center border-t md:border-t-0 md:border-l border-indigo-100">
         <div class="text-center space-y-4">
            <div>
              <span class="block text-3xl font-bold text-indigo-900 mb-1">CONDITIONAL</span>
              <span class="block text-xl font-bold text-red-700">NO-GO</span>
              <span class="block text-xs text-indigo-500 mt-1 uppercase tracking-wide">Sample verdict</span>
            </div>
            <div class="border-t border-indigo-200 pt-4">
              <span class="block text-sm font-semibold text-indigo-800">$12–26M+</span>
              <span class="block text-xs text-indigo-500">unquantified exposure identified</span>
            </div>
            <div>
              <span class="block text-sm font-semibold text-indigo-800">3 Critical Silences</span>
              <span class="block text-xs text-indigo-500">blocking GO clearance</span>
            </div>
         </div>
      </div>
    </div>
  </div>
</section>
