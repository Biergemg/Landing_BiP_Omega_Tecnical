---
import { Image } from 'astro:assets';
import { type HeroProps } from '../../types/components';
import logoImage from '../../assets/logo.png';

interface Props extends HeroProps {}
const {
  headline = "Stop discovering deal-breaking flaws after the term sheet",
  subheadline = "BiP Omega delivers a documented verdict on utility-scale BESS projects — GO, CONDITIONAL NO-GO, or NO-GO — with every finding tied to evidence and every gap named before it costs you. From pre-diligence screening to lender review.",
  ctaText = "Get Your Initial Scope Assessment",
  ctaHref = "#contact"
} = Astro.props;
---

<section class="bg-white relative overflow-hidden">
  <div class="section-container relative z-10 pt-12 pb-16 lg:pt-24 lg:pb-28">
    <div class="max-w-3xl">
      <Image src={logoImage} alt="BiP Omega" class="h-28 lg:h-40 w-auto mb-8 lg:mb-12" />
      <h1 class="text-4xl lg:text-6xl font-bold text-heading mb-6">
        {headline}
      </h1>
      <p class="text-xl text-body mb-8 prose-constrained">
        {subheadline}
        <br/><br/>
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start items-start">
        <a href={ctaHref} class="btn-primary text-center">
          {ctaText}
        </a>
        <span class="text-sm text-slate-500 self-center">Initial scope delivered within 48 hours — no commitment required</span>
      </div>

      <p class="mt-6 text-sm text-slate-500 leading-relaxed max-w-xl">
        You leave with a complete technical position — confirmed facts, flagged assumptions, and documented gaps — defensible in front of any IC or credit committee.
      </p>
    </div>
  </div>
  
  <!-- Subtle institutional pattern/accent can go here -->
  <div class="absolute top-0 right-0 -z-10 w-1/3 h-full bg-bg-light opacity-50 skew-x-12 translate-x-20"></div>
</section>
