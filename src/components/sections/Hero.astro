---
import { Image } from 'astro:assets';
import { type HeroProps } from '../../types/components';
import logoImage from '../../assets/logo.png';

interface Props extends HeroProps {}
const { 
  headline = "Technical Due Diligence for Investment Decision Gating",
  subheadline = "Identify the $9.5–23M in potential unquantified risks hiding in public CEQA/NEPA filings — before due diligence starts.",
  ctaText = "Request Initial Scope",
  ctaHref = "#contact"
} = Astro.props;
---

<section class="bg-white relative overflow-hidden">
  <div class="section-container relative z-10 pt-12 pb-16 lg:pt-24 lg:pb-28">
    <div class="max-w-3xl">
      <Image src={logoImage} alt="BiP Omega" class="h-28 lg:h-40 w-auto mb-8 lg:mb-12" />
      <h1 class="text-3xl lg:text-5xl font-bold text-heading leading-tight mb-6">
        {headline}
      </h1>
      <p class="text-xl text-body mb-8 leading-relaxed">
        {subheadline}
        <br/><br/>
        <span class="font-bold text-heading">No site visits. No NDA required. Only public-record forensics.</span>
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
        <a href={ctaHref} class="btn-primary text-center">
          {ctaText}
        </a>
      </div>
    </div>
  </div>
  
  <!-- Subtle institutional pattern/accent can go here -->
  <div class="absolute top-0 right-0 -z-10 w-1/3 h-full bg-bg-light opacity-50 skew-x-12 translate-x-20"></div>
</section>
