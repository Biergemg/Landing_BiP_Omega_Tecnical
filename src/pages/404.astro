---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404: Not Found" description="Page not found" noIndex={true}>
  <main class="flex min-h-[80vh] flex-col items-center justify-center px-4 text-center text-slate-900">
    <h1 class="mb-4 text-6xl font-bold tracking-tighter sm:text-8xl">404</h1>
    <p class="mb-8 text-xl text-slate-600 sm:text-2xl">Page not found.</p>
    <a href="/" class="inline-flex items-center justify-center rounded-full bg-slate-900 px-8 py-3 text-sm font-medium text-white transition-colors hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-slate-400 focus:ring-offset-2">
      Return Home
    </a>
  </main>
</Layout>
