---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import ProblemStatement from '../components/sections/ProblemStatement.astro';
import Services from '../components/sections/Services.astro';
import Methodology from '../components/sections/Methodology.astro';
import CaseStudy from '../components/sections/CaseStudy.astro';
import WhyRemote from '../components/sections/WhyRemote.astro';
import TrustBar from '../components/sections/TrustBar.astro';
import ScopeDeclaration from '../components/sections/ScopeDeclaration.astro';
import ContactForm from '../components/sections/ContactForm.astro';
import Footer from '../components/partials/Footer.astro';

const seoTitle = "BiP Omega – Technical Due Diligence for Investment Decision Gating | Gustavo Bierge";
const seoDescription = "Technical due diligence for investment decision gating. Identify $9.5-23M in potential unquantified risks hiding in public CEQA/NEPA filings before due diligence starts. No site visits. No NDA required.";
---

<Layout 
	title={seoTitle}
	description={seoDescription}
	page="home"
>
	<main>
		<Hero 
			headline="Technical Due Diligence for Investment Decision Gating"
			subheadline="Identify the $9.5–23M in potential unquantified risks hiding in public CEQA/NEPA filings — before due diligence starts."
		/>
		<ProblemStatement />
		<Services />
		<Methodology />
		<CaseStudy />
		<WhyRemote />
		<TrustBar />
		<ScopeDeclaration />
		<ContactForm />
	</main>
	<Footer />
</Layout>
