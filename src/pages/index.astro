---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import ProblemStatement from '../components/sections/ProblemStatement.astro';
import Services from '../components/sections/Services.astro';
import Methodology from '../components/sections/Methodology.astro';
import CaseStudy from '../components/sections/CaseStudy.astro';
import WhyRemote from '../components/sections/WhyRemote.astro';
import TrustBar from '../components/sections/TrustBar.astro';
import ScopeDeclaration from '../components/sections/ScopeDeclaration.astro';
import ContactForm from '../components/sections/ContactForm.astro';
import Footer from '../components/partials/Footer.astro';

const seoTitle = "BiP Omega – Technical Investment Gating for Utility-Scale BESS Projects | Gustavo Bierge";
const seoDescription = "Public-record technical investment gating for utility-scale BESS projects. Determine whether a project should advance to full due diligence or halt for critical clarification.";
---

<Layout 
	title={seoTitle}
	description={seoDescription}
	page="home"
>
	<main>
		<Hero 
			headline="Technical Investment Gating for Utility-Scale BESS Projects"
			subheadline="Identify whether a project should advance to full due diligence — or halt for critical clarification — using only public records."
		/>
		<ProblemStatement />
		<Services />
		<Methodology />
		<CaseStudy />
		<WhyRemote />
		<TrustBar />
		<ScopeDeclaration />
		<ContactForm />
	</main>
	<Footer />
</Layout>
