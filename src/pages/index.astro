---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import ProblemStatement from '../components/sections/ProblemStatement.astro';
import Services from '../components/sections/Services.astro';
import BESSRiskAreas from '../components/sections/BESSRiskAreas.astro';
import Methodology from '../components/sections/Methodology.astro';
import CaseStudy from '../components/sections/CaseStudy.astro';
import WhyRemote from '../components/sections/WhyRemote.astro';
import TrustBar from '../components/sections/TrustBar.astro';
import ScopeDeclaration from '../components/sections/ScopeDeclaration.astro';
import ContactForm from '../components/sections/ContactForm.astro';
import Footer from '../components/partials/Footer.astro';

const seoTitle = "BiP Omega – Technical Due Diligence for Utility-Scale BESS | Gustavo Bierge";
const seoDescription = "Structured technical due diligence for utility-scale BESS projects. Mandate-adaptive analysis for investment committees, lenders, and independent engineers. Every conclusion traceable.";
---

<Layout
	title={seoTitle}
	description={seoDescription}
	page="home"
>
	<main>
		<Hero />
		<ProblemStatement />
		<Services />
		<BESSRiskAreas />
		<Methodology />
		<CaseStudy />
		<WhyRemote />
		<TrustBar />
		<ScopeDeclaration />
		<ContactForm />
	</main>
	<Footer />
</Layout>
